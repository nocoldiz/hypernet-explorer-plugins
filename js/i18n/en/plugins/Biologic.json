  "b_pos": { "name": "B Positive", "desc": "Less common; compatible with B and AB patients who are also Rh-positive." },
  "ab_pos": { "name": "AB Positive", "desc": "The universal recipient, safely transfused with blood of any ABO or Rh combination." },
  "o_neg": { "name": "O Negative", "desc": "The universal donor, safe for any recipient regardless of their own type." },
  "a_neg": { "name": "A Negative", "desc": "Compatible with any A or AB patient, Rh-positive or negative." },
  "b_neg": { "name": "B Negative", "desc": "Compatible with any B or AB patient, Rh-positive or negative." },
  "ab_neg": { "name": "AB Negative", "desc": "The rarest of the eight common types, and a donor only for other AB patients." },
  "synth_delta": { "name": "Synthetic-Δ", "desc": "Hemoglobin-mimetic synthetic fluorocarbon polymer emulsion. Functions as an artificial universal donor for all standard human and synthetic systems." },
  "synth_psi": { "name": "Synthetic-Ψ", "desc": "Psionic-conductive synthetic fluid infused with neural micro-nanites for augmented bio-electrical conductivity." },
  "azure_hemocyanin": { "name": "Azure (Hemocyanin)", "desc": "Copper-based blue blood inherited from ancient horseshoe crab lineages. Amebocytes rapidly coagulate around bacterial endotoxins, conferring complete immunity to bacterial sepsis." },
  "chlorocruorin": { "name": "Chlorocruorin (Green)", "desc": "Iron-porphyrin respiratory pigment producing vibrant green blood, adapted for hypoxic and high-pressure aquatic depths." },
  "rh_null": { "name": "Rh-null (Golden Blood)", "desc": "Lacks all 61 Rh antigens. A priceless universal donor for any Rh-incompatible patient, but can only receive blood from another Rh-null carrier." },
  "bombay_hh": { "name": "Bombay phenotype (hh)", "desc": "Lacks the fundamental H antigen required for ABO expression. Can donate safely to standard ABO recipients in emergencies, but only receives Bombay (hh)." },
  "duffy_neg": { "name": "Duffy Negative", "desc": "Missing the Duffy antigen; naturally resists blood-borne parasites, but repeat transfusions call for a Duffy-matched donor to avoid immune reactions." },
  "diego_b_neg": { "name": "Diego(b-)", "desc": "An exceedingly rare antigen profile; a safe transfusion needs a donor who shares the same missing antigen." },
  "kidd_b_neg": { "name": "Kidd(b-)", "desc": "A Kidd-negative lineage; repeat exposure to mismatched Kidd antigens provokes a sharp immune response, so donors must be antigen-matched." },
  "colton_neg": { "name": "Colton(a-)", "desc": "A rare phenotype lacking Colton water-channel antigens on erythrocyte membranes." },
  "lutheran_neg": { "name": "Lutheran(a-b-)", "desc": "A rare recessive null phenotype where red blood cells lack both Lu(a) and Lu(b) adhesion glycoproteins." }
