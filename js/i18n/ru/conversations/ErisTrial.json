  "reverseOpeningLines": [
    "Суд идёт. Постарайтесь меня не утомить.",
    "Выпрямите спину. Я судлю и осанку тоже.",
    "Я прочитала ваше дело. Не впечатлена.",
    "Прежде чем начать, кто-нибудь несёт мне вино?",
    "Говорите, когда спрошу. Значит, редко.",
    "Пусть в протоколе будет: я не хотела сюда приходить.",
    "Я и есть закон, творящий мщение."
  ],
  "reverseOpeningReplies": [
    "Ваша честь... это всё недоразумение.",
    "Я не просил божественного судьи.",
    "Может, покончим с этим побыстрее?",
    "*сглатывает* Да, ваша честь.",
    "Вы даже не настоящий судья.",
    "У меня есть права, вообще-то. Кажется.",
    "Все говорили, что вы будете хуже.",
    "Я невиновен. Очевидно же."
  ],
  "reversePressApproaches": [
    "Объяснитесь. Медленно.",
    "Где, собственно, доказательства?",
    "Ха. И вы думали, никто не заметит?",
    "Солжёте — потеряете язык.",
    "...Просто скажите почему.",
    "Дальше. У меня планы на вечер.",
    "Я могу просто прочитать вашу душу, знаете ли."
  ],
  "reverseClosingLines": [
    "Я наслушалась. Суд решит.",
    "Последнее слово. Сделайте его интересным.",
    "Вы были почти убедительны. Почти.",
    "У моего терпения есть дно — и мы его достигли.",
    "Через сто лет это уже не будет иметь значения.",
    "Я сужу вас так, как хотела бы, чтобы судили меня. Страшно, не правда ли?"
  ],
  "reverseFinalPleas": [
    "Что бы вы ни решили, я запомню ваше лицо.",
    "Пожалуйста. Меня ждут люди.",
    "Делайте что хотите. Вы всегда делаете.",
    "Я готов, ваша честь.",
    "Это не правосудие. Это театр.",
    "Пусть боги судят вас так же."
  ],
  "reversePartingLines": [
    "Суд закрыт. Кому-то убрать пол.",
    "Следующее дело. И принесите то вино.",
    "Надеюсь, вы понимаете: это было не лично.",
    "Вообще-то было. Очень лично.",
    "Правосудие утомляет. Как это делают ежедневно?",
    "Впишите в гроссбух. Под «неизбежно».",
    "Я подумаю об этом в темноте."
